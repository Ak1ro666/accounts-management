    "@mui/material": "7.0.2",
    "@mui/x-date-pickers": "8.0.0",
    "@tanstack/react-query": "5.76.0",
    "clsx": "2.1.1",
    "cors": "2.8.5",
    "date-fns": "4.1.0",
    "date-fns-jalali": "latest",
    "express": "5.1.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "json-server": "1.0.0-beta.3",
    "openapi-fetch": "0.14.0",
